meta {
  name: GetMessages
  type: http
  seq: 2
}

get {
  url: {{messages_app_base_url}}/api/messages?page_size=1&archived=false
  body: none
  auth: inherit
}

params:query {
  page_size: 1
  archived: false
  ~maximum_id: 
}

headers {
  x-user: {{x-user-value}}
}

settings {
  encodeUrl: true
  timeout: 0
}
