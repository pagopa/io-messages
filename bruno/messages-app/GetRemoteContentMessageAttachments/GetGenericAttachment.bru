meta {
  name: GetGenericAttachment
  type: http
  seq: 2
}

get {
  url: {{messages_app_base_url}}/api/v1/third-party-messages/{{message_id}}/attachments/attachments/documents/document.pdf?download=true
  body: none
  auth: inherit
}

headers {
