}

vars:pre-request {
  message_id: 01JXVZETAP064HCWTXBWC693QN
}

docs {
  Downloads PDF bytes from the local generic Remote Content mock. The query parameter is forwarded upstream.
}

settings {
  encodeUrl: true
  timeout: 0
}
