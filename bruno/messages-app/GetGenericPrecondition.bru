meta {
  name: GetGenericPrecondition
  type: http
  seq: 11
}

get {
  url: {{messages_app_base_url}}/api/messages/third-party-messages/{{message_id}}/precondition
  body: none
  auth: inherit
}

headers {
  x-user: {{send-func-x-user}}
  ~signature-input: {{send-func-signature-input}}
  ~signature: {{signature}}
  ~x-pagopa-lollipop-original-method: GET
  ~x-pagopa-lollipop-original-url: https://app-backend.io.italia.it/api/v1/third-party-messages/{{message_id}}/precondition
}

vars:pre-request {
  message_id: 01K8MS00000000000000000001
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Generic Remote Content precondition (mock-server-remote-content). Seeded by setup-*-containers.js.
  
  message_id:
  - 01K8MS00000000000000000001: lollipop disabled, 200
  - 01K8MS00000000000000000002: lollipop enabled, 200 (enable the lollipop headers; the mock echoes the lollipop user id in `markdown`)
}
