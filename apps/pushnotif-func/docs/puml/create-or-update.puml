@startuml

title CreateOrUpdateInstallation

actor "IO user" as iou
participant "APIM" as apim

queue "push-notifications" as pnq

box "pushnotif-func"
  participant "CreateOrUpdateInstallation HTTP" as api
  participant "CreateOrUpdateInstallation" as pn
end box

database "installation-summaries" as ic

participant "Notification Hub" as nh

participant "app-insights" as ai

iou -> apim : Create/Update Installation
activate iou
activate apim

apim -> api : PUT /api/communication/v1/installations/{id}
activate api
api --> pnq : Push the Create/Update message to the queue\n(10s visibility delay)
api -[#green]> apim : 200 {"message":"ok"}
deactivate api

apim -[#green]> iou

deactivate apim
deactivate iou

note right of pnq
  **CreateOrUpdateInstallationMessage**
  {
    "installationId": "foo",
    "kind": "CreateOrUpdateInstallation",
    "platform": "fcmv1",
    "pushChannel": "bar",
    "tags": ["foo"]
  }
end note
pn -> pnq : Read a CreateOrUpdateInstallation message
activate pn

pn -> ic : Create/Update installation-summary
activate ic

alt "Error from cosmos"
  ic -[#red]> pn : 5xx from cosmos
  alt "Was last retry"
    pn --> ai : Track an event
  end
  pn -[#red]>X pnq: Throw an error
end

ic -[#green]> pn
deactivate ic

pn -> nh : Create/Update the installation
activate nh
alt "Error from notification hub"
  nh -[#red]> pn : Error
  alt "Was last retry"
    pn --> ai : Track an event
  end
  pn -[#red]>X pnq: Throw an error
else "Success from notification hub"
  nh -[#green]> pn : 201
  deactivate nh
end

deactivate pn

@enduml
